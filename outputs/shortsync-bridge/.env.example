# Generate AUTH_TOKEN locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=
SHORTSYNC_API_KEY=
DRY_RUN=true
# Leave false until a live publishing test has explicitly been approved.
LIVE_PUBLISH_ENABLED=false
HOST=127.0.0.1
PORT=3000
MAX_VIDEO_BYTES=26214400
RATE_LIMIT_PER_MINUTE=20
DATA_DIR=./data
# Exact HTTPS storage host(s) confirmed with ShortSync; no wildcard or URL.
# A missing allowlist deliberately blocks live uploads.
UPLOAD_ALLOWED_HOSTS=
# Optional for dry-run. Required for later Render live mode.
JOURNAL_BACKEND=file
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
